    "typecheck": "tsc --noEmit",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,mts,json,md}\"",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
